{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pokreni aplikaciju",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m streamlit run app.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Testovi",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Provera koda (ruff)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m ruff check .",
      "problemMatcher": []
    },
    {
      "label": "Napravi okruženje (.venv)",
      "type": "shell",
      "command": "python -m venv .venv; .venv/Scripts/python.exe -m pip install -r requirements-dev.txt",
      "problemMatcher": []
    }
  ]
}
