# Izaberite JEDAN besplatni provider (ili ostavite prazno – uzima se prvi čiji ključ postoji)
LLM_PROVIDER=groq

# Groq (najbrži, besplatno): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (veliki kontekst, dobar za ceo PDF, besplatno): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter – modeli sa sufiksom :free : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama lokalno (bez ključa): LLM_PROVIDER=ollama, pa `ollama pull qwen2.5:7b`

# Opciono: drugi model
# LLM_MODEL=llama-3.1-8b-instant
